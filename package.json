{
  "name": "assembleo-api-gateway",
  "version": "1.0.0",
  "description": "Gateway centralizador para todos os microserviços do sistema Assembleo",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "build": "esbuild --bundle --outfile=./dist/index.js --platform=node --target=node20 --format=esm ./src/index.ts",
    "lint": "echo 'Lint not configured'",
    "typecheck": "tsc --noEmit",
    "zip": "zip -j lambda.zip dist/index.js",
    "update": "aws lambda update-function-code --zip-file fileb://lambda.zip --function-name assembleo-gateway",
    "deploy": "run-s build zip update"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.21.4",
    "npm-run-all2": "^6.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.4",
    "dotenv": "^17.2.2",
    "hono": "^4.9.8"
  }
}
